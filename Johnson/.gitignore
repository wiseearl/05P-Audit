# Scoped to Johnson/ only (does not affect other folders in the repository)

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# MCP self-update backups, temp files & agent backups
*.bak
*.tmp
.agents/

# Local secrets & private MCP config (keep *.example.* tracked)
.env
.env.*
!.env.example
mcp_config.json

# Logs
*.log
logs/

# Third-party binaries (auto-downloaded from official site by install_service.bat)
nssm/

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
